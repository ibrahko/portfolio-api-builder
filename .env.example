# Copier en .env et renseigner les valeurs (ne jamais commiter .env)

# Obligatoire en production — générer avec :
# python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=
DJANGO_SETTINGS_MODULE=config.settings.prod
ALLOWED_HOSTS=api.example.com
CORS_ALLOWED_ORIGINS=https://example.com

# PostgreSQL
POSTGRES_DB=portfolio
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Redis (broker Celery)
REDIS_URL=redis://redis:6379/0

# E-mail (SMTP)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Observabilité
SENTRY_DSN=
